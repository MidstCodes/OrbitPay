# ============================================================================
# OrbitPay Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# ============================================================================

# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=OrbitPay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stellar Network
# ---------------------------------------------------------------------------
# Options: testnet | mainnet
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Smart Contract Addresses
# ---------------------------------------------------------------------------
# Deploy your contracts first, then update these addresses.
# See scripts/deploy.sh for deployment instructions.

NEXT_PUBLIC_PAYMENT_CONTRACT_ADDRESS=
NEXT_PUBLIC_NOTIFICATION_CONTRACT_ADDRESS=
NEXT_PUBLIC_HISTORY_CONTRACT_ADDRESS=

# Features
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_EVENTS=true
NEXT_PUBLIC_POLL_INTERVAL_MS=5000

# Soroban (for contract deployment)
# ---------------------------------------------------------------------------
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_SECRET_KEY=
